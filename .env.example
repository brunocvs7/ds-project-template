# Copie para .env (`cp .env.example .env`). O .env NÃO vai para o git.
# Todos os comandos do Makefile carregam este arquivo via `uv run --env-file`.

# Caminhos (opcional — padrão é dentro do projeto)
# DATA_DIR=data
# MODELS_DIR=models
# REPORTS_DIR=reports
# RAW_FILE=data/raw/dataset.csv

# Reprodutibilidade
SEED=42

# Integrações (preencha se usar)
# MLFLOW_TRACKING_URI=
# DATABASE_URL=
# AWS_PROFILE=
